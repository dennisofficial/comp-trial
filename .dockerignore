# Never ship secrets or terraform state into a build context. Encrypted `.enc` files
# are allowed back in — they are useless without a private key, which is not.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.*.enc
**/.env.keys
**/.env.personal
**/.env.local
infra/**/.terraform
infra/**/*.tfstate*
