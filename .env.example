# Neon Postgres — use the POOLED connection string for the app.
# Copy to packages/db/.env and apps/web/.env.local.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooled) connection. Only needed if migrations misbehave over the pooler.
# DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
