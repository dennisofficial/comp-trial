# Loads personal credentials into the shell so `.mcp.json` can expand them.
#
# `${DIGITALOCEAN_API_TOKEN}` in .mcp.json is resolved from the environment Claude Code was
# *launched* in — nothing the repo does at runtime can supply it, which is why this has to be a
# shell hook rather than a script. direnv exports on `cd`, so starting Claude from this directory
# is enough.
#
# This file holds no secrets and is committed. The values live in `.env.personal`, which is
# git-ignored plaintext — the same overlay the rest of the repo uses for machine-local values.
# Run `direnv allow` after editing either file.

dotenv_if_exists .env.personal
