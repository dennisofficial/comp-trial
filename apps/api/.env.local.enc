#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_LOCAL_ENC="02039148aa0dcbae8f762d2d729eebde5e1f29293bd89360abe0340043d79c0228"

# .env.local.enc
# Local development values for the API. Section and key order mirror
# src/config/env/validation.ts — same line, same variable.
#
# NODE_ENV is deliberately absent: the runtime owns it, and pinning it in a dotenv
# file is how builds end up running in the wrong mode.
#
# PORT is deliberately absent, like NODE_ENV. The schema defaults it for local dev and
# the container sets it for deployment (Dockerfile `ENV PORT`, App Platform `http_port`).
# A line here would be a third source able to disagree with the other two.

# ─── Application ──────────────────────────────────
CORS_ALLOWED_ORIGINS="encrypted:BKZ6HcFHoLAjOm2gtet54x4OXSes1JVkBbK/gF8qA2dClUKFDOKcpMnM7U8bWRdOZGC1CKDuej2yMYvcFOq2VuRh+kmDK5fsn7vd82zx9Fc7TTUo8lG1pIn66egTx1R0PVnzStfXe4PZ5dnkeQdXNkG92OPLjA=="

# ─── Sentry ───────────────────────────────────────
# Read by src/instrument.ts straight from process.env, before the Nest container (and
# so EnvService) exists — which is why it is absent from validation.ts.
SENTRY_DSN="encrypted:BLOzaJi1rmftKDFCjZEMaNRD3cW3XOvD25lS9MVC5hLgfLhaeBqN/YocRns7YhDSnhpHiupO5My3VcFK/uFO4pkgDUGICmaHUt+3I/4O5X5lE8cr49qNgxCqopLgmLPa1R61DuI4UmG4aZWZQhoF3x74lutDEENx1hwC7PGeJiW3hvsE+1i8eFoEBZiPEG6Npq5MO7glugpmq1ElZCXQLAXEdbWFKhpf5MDiVwHagr+4/6WWgohMYD9DrrAL1jJ4"

