{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "env:inject": "dotenvx run -f .env.local.enc -f .env.personal --ignore MISSING_ENV_FILE -o --strict --",
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "bun run env:inject -- nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11",
    "@repo/db": "workspace:*",
    "@sentry/nestjs": "^10.69.0",
    "@sentry/profiling-node": "10.69.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
