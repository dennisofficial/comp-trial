{
  "compilerOptions": {
    // node16, not commonjs/node: classic resolution predates `exports` maps, so a package that
    // only exposes a subpath through `exports` (posthog-node/nestjs) is unresolvable and the deep
    // path that *does* typecheck throws ERR_PACKAGE_PATH_NOT_EXPORTED under real Node at boot.
    // The package is CJS (no `"type"` field), so node16 still emits CommonJS for Nest.
    "module": "node16",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "node16",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
