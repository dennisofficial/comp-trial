{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "env:inject": "dotenvx run -f .env.local.enc -f .env.personal --ignore MISSING_ENV_FILE -o --strict --",
    "dev": "bun run env:inject -- next dev",
    "build": "next build",
    "build:local": "bun run env:inject -- next build",
    "start": "bun run env:inject -- next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "openapi:codegen": "bun run scripts/openapi-codegen.ts",
    "openapi:check": "bun run openapi:codegen && git diff --exit-code -- src/store/generated",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/nextjs": "^10.69.0",
    "@sentry/profiling-node": "10.69.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.411.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-redux": "^9.3.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
