#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_LOCAL_ENC="0305e5e03d00d6cd7075e4df47a51c9c3bb338c7d36e4270091d484c841f420fa3"

# .env.local.enc
# Prisma CLI credentials for local development. Key order mirrors .env.example.
#
# Only the Prisma CLI reads this file — the app gets DATABASE_URL from its own
# package (apps/web, apps/api). Migrations are the one thing that must not go
# through the pooler, which is why DIRECT_URL lives here and nowhere else.

# ─── Neon Postgres ────────────────────────────────
DATABASE_URL="encrypted:"
DIRECT_URL="encrypted:"
